{
  "name": "@tws/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "test:reputation": "tsx --env-file=../../.env prisma/reputation-e2e.ts",
    "test:inventory": "tsx --env-file=../../.env prisma/inventory-e2e.ts",
    "test:demo-flow": "tsx --env-file=../../.env prisma/demo-accounts-e2e.ts",
    "test:security": "tsx prisma/security-regression.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "nodemailer": "9.0.4",
    "passport": "0.7.0",
    "passport-facebook": "3.0.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "resend": "6.9.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "11.0.10",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/nodemailer": "8.0.1",
    "@types/passport-facebook": "3.0.3",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "eslint": "9.35.0",
    "prisma": "6.19.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
